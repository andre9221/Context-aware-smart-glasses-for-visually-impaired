# Environment variables for Smart Glasses edge & cloud system
SIMULATION_MODE=True

# Firebase Realtime Database credentials (optional for simulation)
FIREBASE_DATABASE_URL=https://smart-glasses-telemetry-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# Local telemetry server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
